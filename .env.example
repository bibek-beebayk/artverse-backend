DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_MAINTENANCE_TOKEN_MAX_AGE=86400
FIREBASE_SERVICE_ACCOUNT_JSON=

# Printify catalogue integration. Get an API token from
# printify.com/app/account/api and your shop ID from GET /v1/shops.json
# (or the Printify dashboard URL). PRINTIFY_ENABLED is a separate kill switch —
# even with a token set, the integration stays off until this is true, so it
# can be disabled without removing credentials. Run `python manage.py
# printify_test_connection` after configuring these to verify both the token
# and shop ID are actually valid, not just present.
PRINTIFY_API_TOKEN=
PRINTIFY_API_BASE_URL=https://api.printify.com/v1
PRINTIFY_SHOP_ID=
PRINTIFY_USER_AGENT=Artverse/1.0
PRINTIFY_REQUEST_TIMEOUT=30
PRINTIFY_ENABLED=false

# AI image generation (apps.generator). Get a key from Google AI Studio
# (aistudio.google.com/apikey) or Google Cloud Console. GEMINI_ENABLED is a
# separate kill switch, same pattern as PRINTIFY_ENABLED above. This key must
# only ever live here (server-side) — never in the frontend's .env.local.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash-image
GEMINI_ENABLED=false

# Leave these empty to use local SQLite during early setup.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Gunicorn tuning for Railway / production.
# Increase timeout for large admin uploads and keep worker count conservative on small instances.
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=300
GUNICORN_LOG_LEVEL=info

# Railway Buckets production media storage.
# Railway injects these automatically if you attach a Bucket to your service.
# Required variables when USE_RAILWAY_BUCKET=true:
# - BUCKET: actual S3 bucket name
# - ENDPOINT: usually https://storage.railway.app
# - ACCESS_KEY_ID
# - SECRET_ACCESS_KEY
USE_RAILWAY_BUCKET=false
BUCKET=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
RAILWAY_BUCKET_ADDRESSING_STYLE=virtual
RAILWAY_BUCKET_MEDIA_PREFIX=media
RAILWAY_BUCKET_URL_EXPIRY=3600
