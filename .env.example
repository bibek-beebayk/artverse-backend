DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_MAINTENANCE_TOKEN_MAX_AGE=86400

# Leave these empty to use local SQLite during early setup.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Gunicorn tuning for Railway / production.
# Increase timeout for large admin uploads and keep worker count conservative on small instances.
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=300
GUNICORN_LOG_LEVEL=info

# Railway Buckets production media storage.
# Railway injects these automatically if you attach a Bucket to your service.
# Required variables when USE_RAILWAY_BUCKET=true:
# - BUCKET: actual S3 bucket name
# - ENDPOINT: usually https://storage.railway.app
# - ACCESS_KEY_ID
# - SECRET_ACCESS_KEY
USE_RAILWAY_BUCKET=false
BUCKET=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
RAILWAY_BUCKET_ADDRESSING_STYLE=virtual
RAILWAY_BUCKET_MEDIA_PREFIX=media
RAILWAY_BUCKET_URL_EXPIRY=3600
